# Power BI temporary files
*.pbix.tmp
*.tmp
~$*
.pbi/
*.abf

# macOS
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Raw data — the gzipped copy (data/hotel_bookings.csv.gz, 1.1 MB) is committed
# instead, and the notebooks read it directly. The uncompressed CSV is not.
data/*.csv

# Trained model binaries — regenerated by running the notebooks
outputs/*.pkl
outputs/*.joblib

# Source design assets (icons, SVGs). Kept locally so the report can be extended
# in the same style, but not published — the icons come from third-party sets
# whose redistribution terms have not been checked. They are already embedded in
# the .pbix and .pbip, so nothing here is needed to open the report.
design/
